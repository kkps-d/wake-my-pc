<%
  const current = status || { state: "checking" };
  const labels = { checking: "Checking…", reachable: "Reachable", unreachable: "Unreachable", waking: "Waking…", error: "Unavailable" };
  const state = current.state || "checking";
  const trigger = state === "checking" ? "load delay:100ms" : state === "waking" ? "every 2s" : "every 30s";
%>
<div id="pc-controls-<%= pc.id %>" class="pc-controls" data-pc-name="<%= pc.name %>" data-status-state="<%= state %>" hx-get="/pcs/<%= pc.id %>/status" hx-trigger="<%= trigger %>" hx-target="this" hx-swap="outerHTML">
  <span class="status status-<%= state %>" <% if (current.message) { %>title="<%= current.message %>"<% } %>>
    <span class="status-dot" aria-hidden="true"></span><span><%= labels[state] || "Unavailable" %></span>
    <% if (current.message) { %><span class="sr-only"><%= current.message %></span><% } %>
  </span>
  <div class="row-actions">
    <button class="button wake-button" type="button" aria-label="Wake <%= pc.name %>" hx-post="/pcs/<%= pc.id %>/wake" hx-target="#pc-controls-<%= pc.id %>" hx-swap="outerHTML" hx-disabled-elt="this" <%= ["checking", "waking", "reachable"].includes(state) ? "disabled" : "" %>>
      <%- include("icon", { name: "power" }) %><span><%= state === "waking" ? "Waking…" : "Wake" %></span>
    </button>
    <button class="ghost-button trash-button" type="button" aria-label="Remove <%= pc.name %>" title="Remove <%= pc.name %>" hx-get="/pcs/<%= pc.id %>/delete-confirm" hx-target="#delete-dialog-content" hx-swap="innerHTML">
      <%- include("icon", { name: "trash-2" }) %>
    </button>
  </div>
</div>
