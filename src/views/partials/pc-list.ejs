<% const statusMap = typeof statuses !== "undefined" && statuses ? statuses : {}; %>
<section id="pc-list" aria-label="Saved computers">
  <% pcs.forEach((pc) => { %>
    <%- include("pc-row", { pc, status: statusMap[pc.id] }) %>
  <% }) %>
  <p class="empty-state" <%= pcs.length ? "hidden" : "" %>>No computers saved yet</p>
  <p class="search-empty" hidden>No computers found</p>
</section>
