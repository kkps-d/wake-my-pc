<% /* Locals: values?: { name?: string; ipAddress?: string; macAddress?: string }; errors?: Record<string, string>; macMessage?: string. */ %>
<%
  const formValues = typeof values !== "undefined" && values ? values : {};
  const formErrors = typeof errors !== "undefined" && errors ? errors : {};
%>
<div class="dialog-heading">
  <h2 id="add-dialog-title">Add computer</h2>
  <button class="ghost-button" type="button" data-close-dialog="add-pc-dialog" aria-label="Close"><%- include("icon", { name: "x" }) %></button>
</div>
<form id="pc-form" class="form-stack" hx-post="/pcs" hx-target="#add-dialog-content" hx-swap="innerHTML" novalidate>
  <% if (typeof formError !== "undefined" && formError) { %><p class="form-error" role="alert"><%= formError %></p><% } %>
  <div class="form-field">
    <label for="pc-name">Name <span class="field-optional">Optional</span></label>
    <input id="pc-name" name="name" type="text" value="<%= formValues.name || "" %>" autocomplete="off" maxlength="100" aria-describedby="pc-name-help" />
    <p id="pc-name-help" class="field-help">Uses the IP address if left blank.</p>
    <% if (formErrors.name) { %><p class="field-error" role="alert"><%= formErrors.name %></p><% } %>
  </div>
  <div class="form-field">
    <label for="ip-address">IP address</label>
    <input id="ip-address" name="ipAddress" type="text" inputmode="decimal" value="<%= formValues.ipAddress || "" %>" autocomplete="off" placeholder="192.168.1.25" required aria-invalid="<%= formErrors.ipAddress ? "true" : "false" %>" <%- formErrors.ipAddress ? 'aria-describedby="ip-address-error"' : '' %> />
    <% if (formErrors.ipAddress) { %><p id="ip-address-error" class="field-error" role="alert"><%= formErrors.ipAddress %></p><% } %>
  </div>
  <%- include("mac-field", { value: formValues.macAddress || "", error: formErrors.macAddress, message: typeof macMessage !== "undefined" ? macMessage : undefined }) %>
  <div class="dialog-actions">
    <button class="button button-quiet" type="button" data-close-dialog="add-pc-dialog">Cancel</button>
    <button class="button" type="submit" hx-disabled-elt="this"><%- include("icon", { name: "plus" }) %>Add computer</button>
  </div>
</form>
