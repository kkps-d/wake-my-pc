<div class="dialog-heading">
  <h2 id="delete-dialog-title">Remove <%= pc.name %>?</h2>
  <p>Remove this computer from the list?</p>
</div>
<form class="dialog-actions" hx-delete="/pcs/<%= pc.id %>" hx-target="#pc-<%= pc.id %>" hx-swap="outerHTML">
  <button class="button button-quiet" type="button" data-close-dialog="delete-pc-dialog">Cancel</button>
  <button class="button button-danger" type="submit" hx-disabled-elt="this">Remove computer</button>
</form>
